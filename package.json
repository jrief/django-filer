{
  "name": "django-formset",
  "license": "MIT",
  "private": true,
  "scripts": {
    "esbuild": "node client/esbuild.cjs",
    "rollup": "rollup --config client/rollup.config.js",
    "minify": "terser --compress --mangle --output filer/static/filer/js/django-filer.min.js -- filer/static/filer/js/django-filer.min.js",
    "compilescss": "sass --load-path=. client:filer/static/filer/admin/css",
    "buildall": "concurrently \"npm run esbuild -- --debug \" \"npm run compilescss\""
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/modifiers": "^6.0.1",
    "@types/react-dom": "^18.2.4",
    "bootstrap": "^5.3.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.17.19",
    "sass": "^1.63.6",
    "typescript": "^5.1.6",
    "yargs-parser": "^21.1.1"
  }
}
